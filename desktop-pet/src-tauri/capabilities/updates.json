{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "updates",
  "description": "仅设置页可以检查、下载和安装签名更新，并打开本仓库发布页。",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:app:allow-version",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/HanaAyane/ZZZ-Idol-Desktop-Pet/releases"
        },
        {
          "url": "https://github.com/HanaAyane/ZZZ-Idol-Desktop-Pet/releases/tag/*"
        }
      ]
    },
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "core:resources:allow-close"
  ]
}
