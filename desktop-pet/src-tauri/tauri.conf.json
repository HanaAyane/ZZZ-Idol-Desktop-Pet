{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZZZ Idol Desktop Pet",
  "version": "0.1.0",
  "identifier": "com.hana.zzzidolpet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet-airui",
        "title": "妄想天使桌宠",
        "url": "index.html?window=pet&character=airui",
        "width": 520,
        "height": 600,
        "minWidth": 520,
        "minHeight": 600,
        "maxWidth": 520,
        "maxHeight": 600,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "acceptFirstMouse": true
      },
      {
        "label": "pet-nangong",
        "title": "妄想天使桌宠 · 南宫",
        "url": "index.html?window=pet&character=nangong",
        "width": 520,
        "height": 600,
        "minWidth": 520,
        "minHeight": 600,
        "maxWidth": 520,
        "maxHeight": 600,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "acceptFirstMouse": true
      },
      {
        "label": "pet-qianxia",
        "title": "妄想天使桌宠 · 千夏",
        "url": "index.html?window=pet&character=qianxia",
        "width": 520,
        "height": 600,
        "minWidth": 520,
        "minHeight": 600,
        "maxWidth": 520,
        "maxHeight": 600,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "devCsp": "default-src 'self' customprotocol: asset: http://localhost:1420; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1421; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
